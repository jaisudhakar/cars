{%- comment -%}
  Finance calculator — pick a car, slide the deposit and APR, choose a term; the monthly payment
  counts to the new amount. Cars come from a collection.
{%- endcomment -%}
{% render 'car-assets' %}
{{ 'car-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'car-sections.js' | asset_url }}" defer></script>

{%- liquid
  assign s = section.settings
  assign col = s.collection
  if col == blank
    assign col = collections.all
  endif
  assign terms = s.terms | split: ','
-%}
<section id="finance-{{ section.id }}" class="sx section fin" data-fin data-currency="{{ cart.currency.iso_code }}" style="--cream: {{ s.background }};" {{ section.shopify_attributes }}>
  <div class="container fin-grid">
    <div>
      {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2" data-split style="margin-top:16px">{% render 'car-accent', text: s.heading %}</h2>
      {%- if s.text != blank -%}<p class="lead" data-reveal style="margin-top:18px">{{ s.text | escape }}</p>{%- endif -%}
      <div class="fin-car" data-fin-art data-reveal="left"></div>
    </div>
    <div class="fin-card" data-reveal="up">
      <div class="fin-row">
        <label class="fin-label" for="fin-car-{{ section.id }}"><span>Car</span><output data-fin-price></output></label>
        <select id="fin-car-{{ section.id }}" data-fin-car></select>
      </div>
      <div class="fin-row">
        <label class="fin-label" for="fin-down-{{ section.id }}"><span>Deposit</span><output data-fin-down-out></output></label>
        <input id="fin-down-{{ section.id }}" type="range" min="0" max="50" step="5" value="{{ s.down }}" data-fin-down>
      </div>
      <div class="fin-row">
        <div class="fin-label"><span>Term (months)</span></div>
        <div class="fin-terms" data-fin-terms role="group" aria-label="Term in months">
          {%- for t in terms -%}
            {%- assign tm = t | strip | plus: 0 -%}
            <button type="button" data-months="{{ tm }}" aria-pressed="{% if tm == s.term %}true{% else %}false{% endif %}">{{ tm }}</button>
          {%- endfor -%}
        </div>
      </div>
      <div class="fin-row">
        <label class="fin-label" for="fin-apr-{{ section.id }}"><span>APR</span><output data-fin-apr-out></output></label>
        <input id="fin-apr-{{ section.id }}" type="range" min="0" max="15" step="0.1" value="{{ s.apr }}" data-fin-apr>
      </div>
      <div class="fin-out">
        <div><small>Estimated monthly</small><div class="fin-monthly" data-fin-monthly aria-live="polite">0<span>/mo</span></div></div>
        <div class="fin-sum"><span>Amount financed <b data-fin-loan></b></span><span>Total cost <b data-fin-total></b></span></div>
      </div>
      {%- if s.button_label != blank -%}<a class="btn btn-dark btn-block" href="{{ s.button_link | default: '#' }}" style="margin-top:22px">{{ s.button_label | escape }}</a>{%- endif -%}
      {%- if s.note != blank -%}<p class="fin-note">{{ s.note | escape }}</p>{%- endif -%}
    </div>
  </div>
  <script type="application/json" data-fin-json>
    [
      {%- for p in col.products limit: 24 -%}
        {%- render 'car-json', product: p -%}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Car finance calculator",
  "tag": "div",
  "class": "section-car-finance",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Finance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make it *yours* from a monthly price." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose a car, slide the deposit and term, and watch the payment update. Your advisor confirms the final offer." },
    { "type": "collection", "id": "collection", "label": "Cars from collection" },
    { "type": "range", "id": "down", "label": "Default deposit", "min": 0, "max": 50, "step": 5, "unit": "%", "default": 20 },
    { "type": "text", "id": "terms", "label": "Terms (months)", "default": "24, 36, 48, 60, 72" },
    { "type": "number", "id": "term", "label": "Default term (months)", "default": 48 },
    { "type": "range", "id": "apr", "label": "Default APR", "min": 0, "max": 15, "step": 0.1, "unit": "%", "default": 4.9 },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Get my personal quote" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Small print", "default": "Example only. Excludes taxes, registration and fees. Subject to credit approval." },
    { "type": "color", "id": "background", "label": "Background", "default": "#f2f0eb" }
  ],
  "presets": [ { "name": "Car finance calculator" } ]
}
{% endschema %}
