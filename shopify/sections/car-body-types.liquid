{%- comment -%} Body-type tiles — the car drives across and its wheels spin on hover. {%- endcomment -%}
{% render 'car-assets' %}
{{ 'sections.css' | asset_url | stylesheet_tag }}
{{ 'car-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'car-sections.js' | asset_url }}" defer></script>
{%- assign s = section.settings -%}
<section class="sx section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-head">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2" data-split style="margin-top:16px">{% render 'car-accent', text: s.heading %}</h2>
      </div>
      {%- if s.link_label != blank -%}<a class="link-arrow" href="{{ s.link_url | default: routes.all_products_collection_url }}" data-reveal>{{ s.link_label | escape }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>{%- endif -%}
    </div>
    <div class="bt-grid" data-reveal-stagger="0.08">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="bt" href="{% if c != blank %}{{ c.url }}{% else %}#{% endif %}" data-reveal style="--tone:{{ block.settings.tone }}" data-cursor="Go" {{ block.shopify_attributes }}>
          <span class="bt-n">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- if block.settings.image != blank -%}
            <span class="bt-car">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}</span>
          {%- else -%}
            <span class="bt-car" data-car-art="{{ block.settings.style }}" data-paint="{{ block.settings.paint }}"></span>
          {%- endif -%}
          <span class="bt-foot"><span><span class="bt-name">{{ block.settings.title | default: c.title | escape }}</span><span class="bt-count">{{ block.settings.sub | escape }}</span></span><span class="bt-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Car body types",
  "tag": "div",
  "class": "section-car-body-types",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Find your fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by *body type*" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "All inventory" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Title (defaults to the collection)", "default": "Electric" },
      { "type": "text", "id": "sub", "label": "Small text", "default": "2 models · up to 620 km" },
      {
        "type": "select", "id": "style", "label": "Car drawing", "default": "ev",
        "options": [
          { "value": "sedan", "label": "Sedan" }, { "value": "ev", "label": "Electric sedan" }, { "value": "coupe", "label": "Sports coupe" },
          { "value": "suv", "label": "SUV" }, { "value": "hatch", "label": "Hatchback / wagon" }, { "value": "pickup", "label": "Pickup truck" }
        ]
      },
      { "type": "color", "id": "paint", "label": "Paint", "default": "#1f55d6" },
      { "type": "image_picker", "id": "image", "label": "Photo instead of the drawing" },
      { "type": "color", "id": "tone", "label": "Tile colour", "default": "#e6ecf2" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Car body types", "blocks": [
    { "type": "tile", "settings": { "title": "Electric", "sub": "Up to 620 km range", "style": "ev", "paint": "#1f55d6", "tone": "#e6ecf2" } },
    { "type": "tile", "settings": { "title": "SUV", "sub": "7 seats · AWD", "style": "suv", "paint": "#24573f", "tone": "#e8ece4" } },
    { "type": "tile", "settings": { "title": "Performance", "sub": "0–100 from 2.4 s", "style": "coupe", "paint": "#c3161f", "tone": "#f2e7e3" } },
    { "type": "tile", "settings": { "title": "Truck", "sub": "4,500 kg towing", "style": "pickup", "paint": "#c0561f", "tone": "#eeebe2" } }
  ] } ]
}
{% endschema %}
