{%- comment -%}
  Shared fonts, base styles, motion helpers and the car drawings for every car section.
  Safe to render more than once: the browser caches the files and the scripts guard against running twice.
  Usage: {% render 'car-assets' %}
{%- endcomment -%}
<script>document.documentElement.classList.add('motion-ready');</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,400..900;1,62..125,400..900&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
{{ 'base.css' | asset_url | stylesheet_tag }}
{{ 'motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'motion.js' | asset_url }}" defer></script>
<script src="{{ 'car-art.js' | asset_url }}" defer></script>
<script src="{{ 'site-cart.js' | asset_url }}" defer></script>
